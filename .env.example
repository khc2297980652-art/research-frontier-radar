# 复制为 .env 后按需修改（本项目所有外部数据源都是免费、无需鉴权的公开 API）

# 附加到 OpenAlex / Crossref 请求的联系邮箱，用于进入它们的“礼貌池”获得更稳的配额。
# 不设置也能用，但设置后更不容易被限流。CI 中由仓库变量 vars.RADAR_MAILTO 注入。
RADAR_MAILTO=you@example.com

# 本地服务端口，默认 8787；被占用时会自动顺延到下一个可用端口。
PORT=8787

# ---------- AI 速读（可选） ----------
# 配置任一 LLM 密钥后，抓取时会为每篇有摘要的论文生成结构化中文速读（一句话速览+要点+方法+局限）。
# 两个都不配则整体跳过，其余数据照常产出。结果按 DOI 缓存在 data/summaries.json，跨次累积，只算没算过的。
#
# 用哪个模型：留空则自动选择（有 DeepSeek 用 DeepSeek，否则用 Anthropic）；也可显式指定：
#   LLM_PROVIDER=deepseek     # 或 anthropic
LLM_PROVIDER=

# 方案一：DeepSeek（OpenAI 兼容，更省）。密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# DeepSeek 端点，一般不用改；如走代理/中转在此覆盖。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 方案二：Anthropic Claude。密钥：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 速读模型：留空按 provider 取默认（DeepSeek→deepseek-chat；Anthropic→claude-haiku-4-5）。
# 可覆盖：deepseek-chat / deepseek-reasoner，或 claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5。
SUMMARY_MODEL=

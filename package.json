{
  "name": "research-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "科研前沿雷达 — 按学科聚合顶级期刊与预印本的最新文献，重点呈现摘要与配图",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "vite build",
    "build:static": "node scripts/export-static.mjs && vite build --mode static",
    "refresh": "node --env-file-if-exists=.env scripts/refresh-once.mjs",
    "harvest": "node scripts/harvest-journals.mjs",
    "config": "node scripts/build-config.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
